{
  "name": "feng3d-editor",
  "version": "0.6.0",
  "description": "feng3d引擎编辑器\r 编辑器UI基于[egret](https://www.egret.com/)开发。",
  "module": "lib/index.es.js",
  "bundle": "dist/index.js",
  "types": "dist/index.d.ts",
  "namespace": "editor",
  "author": "feng",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "clean": "rimraf \"{lib,dist}\"",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "watch": "tsc --watch",
    "preview": "vite preview",
    "lint": "eslint --ext .js --ext .ts src vite.config.js --ignore-path .gitignore --max-warnings 0",
    "lintfix": "npm run lint -- --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/feng3d/editor.git"
  },
  "keywords": [
    "editor",
    "feng3d"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "libs",
    "src",
    "projects",
    "resource",
    "packages",
    "favicon.ico",
    "index.html",
    "index.js",
    "run.html",
    "run.js"
  ],
  "dependencies": {
    "@feng3d-plugins/cannon": "^0.6.0",
    "@feng3d-plugins/cannon-plugin": "^0.6.0",
    "@feng3d/filesaver": "^0.0.1",
    "@tweenjs/tween.js": "^25.0.0",
    "feng3d": "^0.6.0",
    "jsonc-parser": "^3.1.0",
    "jszip": "^3.10.0",
    "loadjs": "^4.2.0"
  },
  "devDependencies": {
    "@types/loadjs": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "pinia": "^2.2.0",
    "qrcode": "^1.5.4",
    "rimraf": "^6.1.2",
    "tslib": "^2.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue": "^3.5.27"
  },
  "workspaces": [
    "packages/*"
  ]
}
